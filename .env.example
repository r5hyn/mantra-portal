# ─────────────────────────────────────────────
# ServiceM8 API Key
# Go to: ServiceM8 Dashboard → Settings → API → Create API Key
# Paste the key here (it will be used as the HTTP Basic Auth username)
# ─────────────────────────────────────────────
SERVICEM8_API_KEY=your-servicem8-api-key-here

# ─────────────────────────────────────────────
# Booking Link Secret
# A random string used to sign booking URLs so they can't be tampered with.
# Generate one here: https://generate-secret.vercel.app/32
# ─────────────────────────────────────────────
BOOKING_SECRET=replace-with-a-long-random-string

# ─────────────────────────────────────────────
# Your app's public URL (set this after deploying to Vercel)
# e.g. https://mantra-booking.vercel.app
# ─────────────────────────────────────────────
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# ServiceM8 staff UUID to notify on each new booking
# The note will be assigned to this person → they get an in-app alert
# Find it: ServiceM8 web app → Settings → Staff → click the staff member
# → the UUID is in the URL or visible in the API at /api_1.0/staff.json
# ─────────────────────────────────────────────
SERVICEM8_NOTIFY_UUID=paste-jan-uuid-here
